    { "id": "square", "description": "Multiply the input by itself.", "expression": "U32.mul(a, a)" },
    { "id": "double-plus-one", "description": "Add one to the doubled value.", "expression": "U32.add(U32.add(a, a), 1)" },
    { "id": "subtract-self", "description": "Subtract the input from itself.", "expression": "U32.sub(a, a)" },
    { "id": "double-minus-one", "description": "Subtract one from the doubled value.", "expression": "U32.sub(U32.add(a, a), 1)" },
