{
  "schemaVersion": 1,
  "property": {
    "name": "dbl returns x + x",
    "law": "dbl : U32 -> U32",
    "inputs": [0, 1, 2, 7, 21, 100],
    "expectedStdout": "0\n2\n4\n14\n42\n200\n",
    "referenceExpression": "U32.add(a, a)"
  },
  "defects": [
    { "id": "identity", "description": "Return the input unchanged.", "expression": "a" },
    { "id": "constant-zero", "description": "Ignore the input and always return zero.", "expression": "0" },
