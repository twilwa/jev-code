{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twilwa/jev-code/benchmark/bend2/strategy.schema.json",
  "title": "Bend 2 offline specification strategy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "criterion": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "oneOf": [
          { "required": ["criterion"] },
          { "required": ["description"] }
        ]
      }
    }
  }
}
